<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/CipherRain.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn><AssemblyName>CipherRain</AssemblyName><Version>1.0.0</Version><StartupObject>CipherRain.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Vortice.Direct3D11" Version="3.6.2"/><PackageReference Include="Vortice.D3DCompiler" Version="3.6.2"/></ItemGroup>
  <ItemGroup><Content Include="Shaders/Rain.hlsl" CopyToOutputDirectory="PreserveNewest"/><Content Include="Assets/*" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
